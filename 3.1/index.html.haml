.jumbotron.small
  .ui.container.grid.stackable
    .column.ten.wide
      %h1= site.title
      %h2= page.title
    .column.six.wide
      .ui.segment
        %p
          Jakarta Validation 3.1 was published in April 2024.
        %p It is part of Jakarta EE 11 (but can of course be used with plain Java SE as the previous releases).

.ui.container.page-content
  .spec-buttons.text-center
    %a.ui.button.labeled.icon.green.large(href="https://jakarta.ee/specifications/bean-validation/3.1/jakarta-validation-spec-3.1.html")
      %i.icon.book
      Jakarta Validation 3.1 specification
    %a.ui.button.labeled.icon.green.large(href="https://search.maven.org/search?q=g:jakarta.validation%20AND%20a:jakarta.validation-api&core=gav")
      %i.icon.cube
      API Artifact
    %a.ui.button.labeled.icon.green.large(href="https://jakarta.ee/specifications/bean-validation/3.1/apidocs/")
      %i.icon.code
      API JavaDocs

.content-banner
  .ui.container.grid.divided.stackable
    .twelve.wide.column
      %h2 Implementations
      %table.ui.table.celled.striped.unstackable
        %thead
          %tr
            %th(colspan='2') Name
            %th Version
            %th Jakarta EE
